{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/books-manifest.schema.json",
  "title": "After Certainty Aggregate Books Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "generatedAt",
    "ref",
    "releaseTag",
    "books"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "releaseTag": {
      "type": "string",
      "minLength": 1
    },
    "books": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bookEntry"
      }
    }
  },
  "$defs": {
    "coverImageVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "width",
        "height",
        "format",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^book-covers/[a-zA-Z0-9._-]+/(detail|card|thumbnail)\\.webp$"
        },
        "url": {
          "type": "string",
          "pattern": "^/generated/book-covers/[a-zA-Z0-9._-]+/(detail|card|thumbnail)\\.webp$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "const": "webp"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "formatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "file",
        "url"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "source",
        "status",
        "title",
        "authors",
        "coverImage",
        "coverImagePath",
        "openGraphImage",
        "openGraphImagePath",
        "bookDir",
        "docx",
        "epub",
        "pdf"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "slugAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "companionOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "companionBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "books",
            "upcoming"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "publicationDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 date (YYYY-MM-DD) when the book was published"
        },
        "coverImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverImagePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "openGraphImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "openGraphImagePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverImages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detail", "card", "thumbnail"],
          "properties": {
            "detail": { "$ref": "#/$defs/coverImageVariant" },
            "card": { "$ref": "#/$defs/coverImageVariant" },
            "thumbnail": { "$ref": "#/$defs/coverImageVariant" }
          }
        },
        "coverImageGeneration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceSha256", "generatorVersion"],
          "properties": {
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "generatorVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "bookDir": {
          "type": "string",
          "minLength": 1
        },
        "docx": {
          "$ref": "#/$defs/formatEntry"
        },
        "epub": {
          "$ref": "#/$defs/formatEntry"
        },
        "pdf": {
          "$ref": "#/$defs/formatEntry"
        }
      }
    }
  }
}
