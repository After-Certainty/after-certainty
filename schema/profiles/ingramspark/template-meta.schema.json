{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/profiles/ingramspark/template-meta.schema.json",
  "title": "IngramSpark cover template observed metadata",
  "description": "Observed geometry from an IngramSpark Cover Template Generator request. Compared to book.yml print.trim / print.cover at validation time; not a second hand-maintained trim authority. Accepts legacy flat form (supplied-wrap PDF) or versioned raster-wrap form.",
  "oneOf": [
    { "$ref": "#/$defs/legacyFlat" },
    { "$ref": "#/$defs/rasterV1" }
  ],
  "$defs": {
    "trimInches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_inches", "height_inches"],
      "properties": {
        "width_inches": { "type": "number", "exclusiveMinimum": 0 },
        "height_inches": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "mediaBoxInches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_inches", "height_inches"],
      "description": "Full-wrap PDF media box (front + spine + back + bleed), not trim size.",
      "properties": {
        "width_inches": { "type": "number", "exclusiveMinimum": 0 },
        "height_inches": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "legacyFlat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_count",
        "trim",
        "binding",
        "paper",
        "color_mode",
        "media_box"
      ],
      "properties": {
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Interior page count the template was generated for (PDF page count as submitted)."
        },
        "trim": { "$ref": "#/$defs/trimInches" },
        "binding": {
          "type": "string",
          "enum": ["perfect-bound"]
        },
        "paper": {
          "type": "string",
          "enum": ["cream", "white"]
        },
        "color_mode": {
          "type": "string",
          "enum": ["black-and-white", "color"],
          "description": "Interior color mode the template assumed."
        },
        "media_box": { "$ref": "#/$defs/mediaBoxInches" },
        "spine_width_inches": {
          "type": "number",
          "minimum": 0
        },
        "barcode_supplied": {
          "type": "boolean",
          "description": "True when the wrap includes a supplied barcode; must match print.cover.barcode_mode."
        },
        "spine_text": {
          "type": "boolean",
          "description": "True when the wrap includes spine text (forbidden for paperback under 48 pages)."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rasterV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manufacturing",
        "geometry",
        "raster"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["ingramspark"]
            },
            "template_file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "manufacturing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trim_width_inches",
            "trim_height_inches",
            "binding",
            "paper",
            "interior_color_mode",
            "page_count"
          ],
          "properties": {
            "trim_width_inches": { "type": "number", "exclusiveMinimum": 0 },
            "trim_height_inches": { "type": "number", "exclusiveMinimum": 0 },
            "binding": {
              "type": "string",
              "enum": ["perfect-bound"]
            },
            "paper": {
              "type": "string",
              "enum": ["cream", "white"]
            },
            "interior_color_mode": {
              "type": "string",
              "enum": ["black-and-white", "color"]
            },
            "page_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "media_box_width_points",
            "media_box_height_points",
            "spine_width_points",
            "bleed_points"
          ],
          "properties": {
            "media_box_width_points": { "type": "number", "exclusiveMinimum": 0 },
            "media_box_height_points": { "type": "number", "exclusiveMinimum": 0 },
            "spine_width_points": { "type": "number", "minimum": 0 },
            "bleed_points": { "type": "number", "minimum": 0 },
            "safe_inset_points": {
              "type": "number",
              "minimum": 0,
              "description": "Optional inset from trim for type-safety guides on the inspection overlay."
            }
          }
        },
        "raster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_ppi",
            "expected_width_pixels",
            "expected_height_pixels"
          ],
          "properties": {
            "required_ppi": {
              "type": "integer",
              "minimum": 72,
              "description": "Authoritative PPI for pixel↔media-box mapping; embedded PNG DPI is ignored."
            },
            "expected_width_pixels": {
              "type": "integer",
              "minimum": 1
            },
            "expected_height_pixels": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "barcode_reserve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "width_inches",
            "height_inches",
            "x_points",
            "y_points"
          ],
          "properties": {
            "required": { "type": "boolean" },
            "width_inches": { "type": "number", "exclusiveMinimum": 0 },
            "height_inches": { "type": "number", "exclusiveMinimum": 0 },
            "x_points": {
              "type": "number",
              "minimum": 0,
              "description": "Lower-left X of the reserve in PDF media-box coordinates (points)."
            },
            "y_points": {
              "type": "number",
              "minimum": 0,
              "description": "Lower-left Y of the reserve in PDF media-box coordinates (points)."
            }
          }
        },
        "barcode_supplied": {
          "type": "boolean"
        },
        "spine_text": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
