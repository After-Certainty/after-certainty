{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/book.schema.json",
  "title": "After Certainty Book Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "publishing",
    "book",
    "paths",
    "build",
    "frontmatter",
    "github"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "validate_boundary": {
          "type": "boolean",
          "description": "When true, fail export if reader-facing units contain internal repo paths, planning sections, or similar publication leaks."
        }
      }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language",
        "copyright_year"
      ],
      "anyOf": [
        {
          "required": [
            "author"
          ]
        },
        {
          "required": [
            "authors"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/author"
          }
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "copyright_year": {
          "type": "integer",
          "minimum": 1900
        },
        "title_page_cover": {
          "type": "string",
          "minLength": 1
        },
        "title_page_cover_unnumbered": {
          "type": "boolean"
        },
        "open_graph_image": {
          "type": "string",
          "minLength": 1
        },
        "title_page_footer": {
          "type": "string"
        },
        "title_page_newpage_after": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "prose",
            "poetry"
          ],
          "default": "prose"
        },
        "slug_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "companion_of": {
          "type": "string",
          "minLength": 1,
          "description": "Book id this edition is a companion to (e.g. a revised edition points at the prior volume)."
        },
        "companion_books": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Other book ids that are companions to this work (e.g. related edition)."
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable work slug shared across editions (without work- prefix)."
        },
        "edition_relationship": {
          "type": "string",
          "enum": [
            "sole",
            "primary",
            "companion",
            "superseded"
          ],
          "description": "Edition relationship within a work. Defaults to sole when omitted."
        },
        "is_canonical": {
          "type": "boolean",
          "description": "Whether this edition is the canonical public edition for its work."
        },
        "edition_label": {
          "type": "string",
          "minLength": 1,
          "description": "Public label such as Primary volume or Companion edition."
        },
        "content_type": {
          "type": "string",
          "enum": [
            "nonfiction",
            "fiction",
            "handbook",
            "essay_collection",
            "poetry"
          ],
          "description": "Public catalog content type (orthogonal to kind prose|poetry)."
        },
        "search_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Book-local discovery aliases (earlier titles, short names)."
        },
        "overview": {
          "$ref": "#/$defs/bookOverview"
        },
        "isbns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\d{9}[\\dX]|97[89]\\d{10})$"
          },
          "minItems": 1
        },
        "purchase_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purchaseLink"
          },
          "minItems": 1
        },
        "literary_form": {
          "type": "string",
          "enum": [
            "novel",
            "poetry_collection",
            "monograph",
            "handbook",
            "essay_collection",
            "field_notes",
            "other"
          ],
          "description": "Optional literary or publishing form (orthogonal refinement of content_type)."
        },
        "publication_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date of first public publication for this edition."
        },
        "edition_published_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date this edition was published (when distinct from firstPublished)."
        },
        "substantially_revised_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date of a substantial public revision, if any."
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manuscript",
        "output"
      ],
      "properties": {
        "manuscript": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagrams"
      ],
      "properties": {
        "diagrams": {
          "$ref": "#/$defs/assetsDiagrams"
        }
      }
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate"
      ],
      "properties": {
        "generate": {
          "$ref": "#/$defs/frontmatterGenerate"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats"
      ],
      "properties": {
        "ci": {
          "type": "boolean"
        },
        "typst": {
          "$ref": "#/$defs/typstBuildConfig"
        },
        "formats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epub": {
              "$ref": "#/$defs/formatConfig"
            },
            "pdf": {
              "$ref": "#/$defs/pdfFormatConfig"
            },
            "docx": {
              "$ref": "#/$defs/docxFormatConfig"
            },
            "html": {
              "$ref": "#/$defs/formatConfig"
            }
          },
          "minProperties": 1
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "release_tag",
        "artifacts"
      ],
      "properties": {
        "release": {
          "type": "boolean"
        },
        "release_tag": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "media": {
      "$ref": "#/$defs/bookMediaSpec"
    }
  },
  "$defs": {
    "bookOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centralQuestion",
        "whyItExists",
        "audience",
        "nonGoals"
      ],
      "properties": {
        "centralQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "whyItExists": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "nonGoals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selectedConcepts": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "selectedPatterns": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "readBefore": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "readNext": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revisedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1
        },
        "relatedWorks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workId",
              "relationship",
              "reason"
            ],
            "properties": {
              "workId": {
                "type": "string",
                "minLength": 1,
                "description": "Bare work slug (without work- prefix) or work-* id."
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "prepares_for",
                  "deepens",
                  "applies",
                  "historicizes",
                  "fictionalizes",
                  "contrasts_with",
                  "companion_to",
                  "continues",
                  "reframes"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "purchaseLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailer",
        "url"
      ],
      "properties": {
        "retailer": {
          "type": "string",
          "enum": [
            "amazon",
            "apple_books",
            "google_play",
            "barnes_noble",
            "bookshop",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bookMediaSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtubeVideoId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{6,}$"
            }
          }
        },
        "patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtubePlaylistUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string"
        }
      }
    },
    "formatConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "docxFormatConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interior_finish": {
          "type": "boolean",
          "description": "Post-process DOCX: silent front matter, Arabic from Introduction, no running heads on openers, TOC field."
        }
      }
    },
    "pdfFormatConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "page_size": {
          "type": "string"
        },
        "pdf_engine": {
          "type": "string",
          "enum": [
            "xelatex",
            "typst"
          ]
        },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "string"
            },
            "bottom": {
              "type": "string"
            },
            "left": {
              "type": "string"
            },
            "right": {
              "type": "string"
            }
          }
        }
      }
    },
    "assetsDiagrams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_width": {
          "type": "integer",
          "minimum": 1
        },
        "auto_discover": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "svg",
              "png"
            ],
            "properties": {
              "svg": {
                "type": "string",
                "minLength": 1
              },
              "png": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "frontmatterGenerate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title_page": {
          "$ref": "#/$defs/frontmatterTemplateBlock"
        },
        "copyright": {
          "$ref": "#/$defs/frontmatterTemplateBlock"
        },
        "about_the_series": {
          "$ref": "#/$defs/frontmatterTemplateBlock"
        }
      }
    },
    "typstBuildConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "min_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frontmatterTemplateBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_template",
        "output"
      ],
      "properties": {
        "repo_template": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
