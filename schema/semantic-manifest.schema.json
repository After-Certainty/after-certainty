{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/semantic-manifest.schema.json",
  "title": "After Certainty Semantic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "generatedAt",
    "ref",
    "releaseTag",
    "books",
    "glossary",
    "patterns",
    "situations",
    "sources",
    "relationships",
    "ontology"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "releaseTag": {
      "type": "string",
      "minLength": 1
    },
    "books": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticBookEntry"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossaryEntry"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternEntry"
      }
    },
    "situations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/situationEntry"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    },
    "thinkers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thinkerEntry"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipEntry"
      }
    },
    "ontology": {
      "$ref": "#/$defs/ontologyBlock"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^2\\.\\d+$",
      "description": "Additive contract version. 2.1 introduces works/editions and discovery collections. 2.2 adds parts/chapters, literaryForm, overview.relatedWorks. 2.3 adds selected concept/pattern roles, grounding provenance, richer chapter transitions, and thinker identity classes."
    },
    "sourceCommit": {
      "type": [
        "string",
        "null"
      ],
      "description": "Git commit SHA of the content tree used to generate this manifest, when available."
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workEntry"
      }
    },
    "editions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/editionEntry"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/questionEntry"
      }
    },
    "trails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trailEntry"
      }
    },
    "shelves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shelfEntry"
      }
    },
    "changeEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeEventEntry"
      }
    },
    "searchAliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/searchAliasEntry"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/partEntry"
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapterEntry"
      }
    }
  },
  "$defs": {
    "coverImageVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "width",
        "height",
        "format",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^book-covers/[a-zA-Z0-9._-]+/(detail|card|thumbnail)\\.webp$"
        },
        "url": {
          "type": "string",
          "pattern": "^/generated/book-covers/[a-zA-Z0-9._-]+/(detail|card|thumbnail)\\.webp$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "const": "webp"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "coverImages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail",
        "card",
        "thumbnail"
      ],
      "properties": {
        "detail": {
          "$ref": "#/$defs/coverImageVariant"
        },
        "card": {
          "$ref": "#/$defs/coverImageVariant"
        },
        "thumbnail": {
          "$ref": "#/$defs/coverImageVariant"
        }
      }
    },
    "coverImageGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "generatorVersion"
      ],
      "properties": {
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generatorVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "formatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "file",
        "url"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "semanticBookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "source",
        "status",
        "title",
        "summary",
        "authors",
        "concepts",
        "patterns",
        "sources",
        "coverImage",
        "coverImagePath",
        "openGraphImage",
        "openGraphImagePath",
        "bookDir",
        "docx",
        "epub",
        "pdf"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^book-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "slugAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "companionOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "companionBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "books",
            "upcoming"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "publicationDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 date (YYYY-MM-DD) when the book was published"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^source-[a-zA-Z0-9._-]+$"
          }
        },
        "coverImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverImagePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "openGraphImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "openGraphImagePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverImages": {
          "$ref": "#/$defs/coverImages"
        },
        "coverImageGeneration": {
          "$ref": "#/$defs/coverImageGeneration"
        },
        "bookDir": {
          "type": "string",
          "minLength": 1
        },
        "docx": {
          "$ref": "#/$defs/formatEntry"
        },
        "epub": {
          "$ref": "#/$defs/formatEntry"
        },
        "pdf": {
          "$ref": "#/$defs/formatEntry"
        },
        "media": {
          "$ref": "#/$defs/bookMedia"
        },
        "isbns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\d{9}[\\dX]|97[89]\\d{10})$"
          },
          "minItems": 1
        },
        "purchaseLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purchaseLink"
          },
          "minItems": 1
        },
        "workId": {
          "type": "string",
          "pattern": "^work-[a-zA-Z0-9._-]+$"
        },
        "editionId": {
          "type": "string",
          "pattern": "^book-[a-zA-Z0-9._-]+$"
        },
        "isCanonical": {
          "type": "boolean"
        },
        "editionRelationship": {
          "type": "string",
          "enum": [
            "sole",
            "primary",
            "companion",
            "superseded"
          ]
        },
        "editionLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentType": {
          "type": "string",
          "enum": [
            "nonfiction",
            "fiction",
            "handbook",
            "essay_collection",
            "poetry"
          ]
        },
        "publicStatus": {
          "type": "string",
          "enum": [
            "published",
            "upcoming",
            "revised",
            "superseded",
            "archived",
            "forthcoming",
            "in_progress",
            "draft"
          ]
        },
        "availability": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "download_docx",
              "download_epub",
              "download_pdf",
              "available_in_print"
            ]
          }
        },
        "searchAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overview": {
          "$ref": "#/$defs/bookOverview"
        },
        "literaryForm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "novel",
            "poetry_collection",
            "monograph",
            "handbook",
            "essay_collection",
            "field_notes",
            "other",
            null
          ]
        }
      }
    },
    "purchaseLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailer",
        "url"
      ],
      "properties": {
        "retailer": {
          "type": "string",
          "enum": [
            "amazon",
            "apple_books",
            "google_play",
            "barnes_noble",
            "bookshop",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bookMedia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtubeVideoId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{6,}$"
            }
          }
        },
        "patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtubePlaylistUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "mediaInfographic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "path",
        "width",
        "height"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "trajectoryBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "earlySignals": {
          "$ref": "#/$defs/stringList"
        },
        "intensificationSignals": {
          "$ref": "#/$defs/stringList"
        },
        "failureModes": {
          "$ref": "#/$defs/stringList"
        },
        "restorationPaths": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "manifestationsBlock": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "dynamicEnrichmentFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recognitionSignals": {
          "$ref": "#/$defs/stringList"
        },
        "questions": {
          "$ref": "#/$defs/stringList"
        },
        "counterbalances": {
          "$ref": "#/$defs/stringList"
        },
        "manifestations": {
          "$ref": "#/$defs/manifestationsBlock"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectoryBlock"
        }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "shortDefinition",
        "termKind",
        "isCoreTerm",
        "relatedConcepts",
        "relatedPatterns",
        "relatedBooks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^concept-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortDefinition": {
          "type": "string"
        },
        "longDefinition": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "termKind": {
          "type": "string",
          "enum": [
            "core",
            "supporting",
            "extended"
          ]
        },
        "isCoreTerm": {
          "type": "boolean"
        },
        "relatedConcepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        },
        "mentionsByBook": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "recognitionSignals": {
          "$ref": "#/$defs/stringList"
        },
        "questions": {
          "$ref": "#/$defs/stringList"
        },
        "counterbalances": {
          "$ref": "#/$defs/stringList"
        },
        "manifestations": {
          "$ref": "#/$defs/manifestationsBlock"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectoryBlock"
        },
        "grounding": {
          "$ref": "#/$defs/groundingBlock"
        }
      }
    },
    "patternEntry": {
      "description": "Pattern entry with structured narrative fields (setup, problem, forces, observation, example) for rich JSON-LD Article markup using hasPart/articleSection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "relatedConcepts",
        "relatedPatterns",
        "relatedBooks",
        "relatedSources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pattern-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "setup": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "forces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observation": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "relatedConcepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedSources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^source-[a-zA-Z0-9._-]+$"
          }
        },
        "youtubeVideoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{6,}$"
        },
        "mediumArticleUrl": {
          "type": "string",
          "format": "uri"
        },
        "infographic": {
          "$ref": "#/$defs/mediaInfographic"
        },
        "recognitionSignals": {
          "$ref": "#/$defs/stringList"
        },
        "questions": {
          "$ref": "#/$defs/stringList"
        },
        "counterbalances": {
          "$ref": "#/$defs/stringList"
        },
        "manifestations": {
          "$ref": "#/$defs/manifestationsBlock"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectoryBlock"
        },
        "grounding": {
          "$ref": "#/$defs/groundingBlock"
        }
      }
    },
    "situationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "activePatterns",
        "relatedConcepts",
        "relatedBooks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^situation-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "activePatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedConcepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedChapterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^chapter-[a-zA-Z0-9._-]+$"
          }
        },
        "recognitionSignals": {
          "$ref": "#/$defs/stringList"
        },
        "questions": {
          "$ref": "#/$defs/stringList"
        },
        "counterbalances": {
          "$ref": "#/$defs/stringList"
        },
        "manifestations": {
          "$ref": "#/$defs/manifestationsBlock"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectoryBlock"
        }
      }
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "type",
        "summary",
        "concepts",
        "patterns",
        "relatedBooks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^source-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "book",
            "article",
            "report",
            "standard",
            "dataset",
            "speech",
            "case",
            "website",
            "institutional_document"
          ]
        },
        "creatorNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "creatorSlugs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "title": {
          "type": "string",
