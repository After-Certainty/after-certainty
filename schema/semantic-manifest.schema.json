{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/semantic-manifest.schema.json",
  "title": "After Certainty Semantic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "generatedAt",
    "ref",
    "releaseTag",
    "books",
    "glossary",
    "patterns",
    "sources",
    "relationships",
    "ontology"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "repository": {
      "type": ["string", "null"]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "releaseTag": {
      "type": "string",
      "minLength": 1
    },
    "books": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticBookEntry"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossaryEntry"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternEntry"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipEntry"
      }
    },
    "ontology": {
      "$ref": "#/$defs/ontologyBlock"
    }
  },
  "$defs": {
    "formatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "file", "url"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },
    "semanticBookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "source",
        "status",
        "title",
        "summary",
        "authors",
        "concepts",
        "patterns",
        "sources",
        "coverImage",
        "coverImagePath",
        "bookDir",
        "docx",
        "epub",
        "pdf"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^book-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "slugAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "companionOf": {
          "type": ["string", "null"]
        },
        "companionBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "enum": ["books", "upcoming"]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        },
        "summary": {
          "type": ["string", "null"]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": ["integer", "null"]
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^source-[a-zA-Z0-9._-]+$"
          }
        },
        "coverImage": {
          "type": ["string", "null"]
        },
        "coverImagePath": {
          "type": ["string", "null"]
        },
        "bookDir": {
          "type": "string",
          "minLength": 1
        },
        "docx": {
          "$ref": "#/$defs/formatEntry"
        },
        "epub": {
          "$ref": "#/$defs/formatEntry"
        },
        "pdf": {
          "$ref": "#/$defs/formatEntry"
        },
        "media": {
          "$ref": "#/$defs/bookMedia"
        },
        "isbns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\d{9}[\\dX]|97[89]\\d{10})$"
          },
          "minItems": 1
        },
        "purchaseLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purchaseLink"
          },
          "minItems": 1
        }
      }
    },
    "purchaseLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retailer", "url"],
      "properties": {
        "retailer": {
          "type": "string",
          "enum": [
            "amazon",
            "apple_books",
            "google_play",
            "barnes_noble",
            "bookshop",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bookMedia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtubeVideoId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{6,}$"
            }
          }
        },
        "patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtubePlaylistUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "mediaInfographic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "path", "width", "height"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "shortDefinition",
        "termKind",
        "isCoreTerm",
        "relatedConcepts",
        "relatedPatterns",
        "relatedBooks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^concept-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortDefinition": {
          "type": "string"
        },
        "longDefinition": {
          "type": "string"
        },
        "termKind": {
          "type": "string",
          "enum": ["core", "supporting", "extended"]
        },
        "isCoreTerm": {
          "type": "boolean"
        },
        "relatedConcepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        },
        "mentionsByBook": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "patternEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "setup",
        "problem",
        "forces",
        "observation",
        "example",
        "relatedConcepts",
        "relatedPatterns",
        "relatedBooks",
        "relatedSources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pattern-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "setup": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "forces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observation": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "relatedConcepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedSources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^source-[a-zA-Z0-9._-]+$"
          }
        },
        "youtubeVideoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{6,}$"
        },
        "mediumArticleUrl": {
          "type": "string",
          "format": "uri"
        },
        "infographic": {
          "$ref": "#/$defs/mediaInfographic"
        }
      }
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "type", "summary", "concepts", "patterns", "relatedBooks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^source-[a-zA-Z0-9._-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-zA-Z0-9._-]+$"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pattern-[a-zA-Z0-9._-]+$"
          }
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[a-zA-Z0-9._-]+$"
          }
        }
      }
    },
    "relationshipEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relationship", "description"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ontologyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masterTerms", "structuralPressures"],
      "properties": {
        "masterTerms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "slug", "title", "preserves"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^concept-[a-zA-Z0-9._-]+$"
              },
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "preserves": {
                "type": "string"
              }
            }
          }
        },
        "structuralPressures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "slug", "title", "effect"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^concept-[a-zA-Z0-9._-]+$"
              },
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "effect": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
