{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/semantic/source-entry.schema.json",
  "title": "Semantic source entry YAML",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "type", "summary", "concepts", "patterns", "relatedBooks"],
  "properties": {
    "slug": { "$ref": "common.json#/$defs/slug" },
    "name": { "$ref": "common.json#/$defs/nonEmptyString" },
    "type": { "$ref": "common.json#/$defs/nonEmptyString" },
    "summary": { "type": "string" },
    "concepts": { "$ref": "common.json#/$defs/conceptSlugList" },
    "patterns": { "$ref": "common.json#/$defs/patternSlugList" },
    "relatedBooks": { "$ref": "common.json#/$defs/bookSlugList" },
    "sourceKind": {
      "type": "string",
      "enum": [
        "book",
        "article",
        "report",
        "standard",
        "dataset",
        "speech",
        "case",
        "website",
        "institutional_document"
      ]
    },
    "creatorNames": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/nonEmptyString" },
      "minItems": 1
    },
    "creatorSlugs": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/slug" },
      "minItems": 1
    },
    "title": { "$ref": "common.json#/$defs/nonEmptyString" },
    "citation": { "type": "string" },
    "year": { "type": "integer", "minimum": 1000, "maximum": 2100 },
    "publisher": { "$ref": "common.json#/$defs/nonEmptyString" },
    "institution": { "$ref": "common.json#/$defs/nonEmptyString" },
    "url": { "type": "string", "format": "uri" },
    "whyThisMatters": { "type": "string" }
  }
}
