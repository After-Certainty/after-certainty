{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/semantic/question-entry.schema.json",
  "title": "Semantic question entry YAML",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "question",
    "summary",
    "orientation",
    "whatThisIsNot",
    "status",
    "families",
    "primaryBookId",
    "pathStops",
    "closingReflection"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/slug"
    },
    "slug": {
      "$ref": "common.json#/$defs/slug"
    },
    "question": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "summary": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "orientation": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "whatThisIsNot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.json#/$defs/nonEmptyString"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "featuredRank": {
      "type": "integer",
      "minimum": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.json#/$defs/nonEmptyString"
      }
    },
    "primaryBookId": {
      "type": "string",
      "pattern": "^book-[a-zA-Z0-9._-]+$"
    },
    "relatedQuestionIds": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/slug"
      }
    },
    "searchHints": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/nonEmptyString"
      }
    },
    "pathStops": {
      "$ref": "#/$defs/pathStops"
    },
    "closingReflection": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "carryForwardQuestion": {
      "type": "string"
    },
    "createdDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$defs": {
    "pathStops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pathStop"
      }
    },
    "pathStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "entityType",
        "description"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "entityType": {
          "type": "string",
          "enum": [
            "book",
            "chapter",
            "concept",
            "pattern",
            "situation",
            "thinker",
            "source",
            "podcast_episode",
            "external"
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "bookSlug": {
          "type": "string",
          "minLength": 1
        },
        "externalUrl": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "$ref": "common.json#/$defs/nonEmptyString"
        },
        "whyThisFollows": {
          "type": "string"
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "optional": {
          "type": "boolean"
        },
        "excerpt": {
          "type": "string"
        },
        "fictionDoorway": {
          "type": "boolean"
        },
        "titleOverride": {
          "type": "string"
        }
      }
    }
  }
}
