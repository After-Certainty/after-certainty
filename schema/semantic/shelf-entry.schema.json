{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/semantic/shelf-entry.schema.json",
  "title": "Semantic shelf entry YAML",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "description",
    "displayOrder",
    "featured",
    "status",
    "selection"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/slug"
    },
    "slug": {
      "$ref": "common.json#/$defs/slug"
    },
    "title": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "description": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "displayOrder": {
      "type": "integer",
      "minimum": 1
    },
    "featured": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden"
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "bookSlugs"
          ],
          "properties": {
            "mode": {
              "const": "curated"
            },
            "bookSlugs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.json#/$defs/slug"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rule"
          ],
          "properties": {
            "mode": {
              "const": "rule"
            },
            "rule": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "values"
                  ],
                  "properties": {
                    "type": {
                      "const": "contentType"
                    },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "enum": [
                          "nonfiction",
                          "fiction",
                          "handbook",
                          "essay_collection"
                        ]
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "values"
                  ],
                  "properties": {
                    "type": {
                      "const": "status"
                    },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "allPublic"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
