{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after-certainty.com/schema/semantic/playlist-entry.schema.json",
  "title": "Semantic playlist entry YAML",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "platform",
    "externalId",
    "tracks"
  ],
  "properties": {
    "slug": {
      "$ref": "common.json#/$defs/slug"
    },
    "title": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "description": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "suno"
      ]
    },
    "externalId": {
      "$ref": "common.json#/$defs/nonEmptyString"
    },
    "shareId": {
      "type": "string"
    },
    "snapshotDate": {
      "type": "string"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "songSlug",
          "recordingExternalId"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "songSlug": {
            "$ref": "common.json#/$defs/slug"
          },
          "recordingExternalId": {
            "$ref": "common.json#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
