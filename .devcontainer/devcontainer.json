{
  "name": "After Certainty (credential-free)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {},
  "postCreateCommand": "pip install -r requirements.txt || true; echo 'Prefer: curl -LsSf https://astral.sh/uv/install.sh | sh && uv sync --frozen'",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"]
    }
  },
  "mounts": [],
  "remoteEnv": {
    "GITHUB_TOKEN": "",
    "GH_TOKEN": "",
    "SSH_AUTH_SOCK": ""
  },
  "containerEnv": {
    "GITHUB_TOKEN": "",
    "GH_TOKEN": ""
  },
  "runArgs": ["--security-opt", "no-new-privileges"]
}
