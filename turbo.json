{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "SEMANTIC_MANIFEST_USE_LOCAL",
        "SEMANTIC_MANIFEST_OFFLINE",
        "VERCEL_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "passThroughEnv": ["CACHE_REVALIDATE_SECRET", "PODCAST_RSS_URL"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "validate:installed-manifest": {
      "dependsOn": ["@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "validate:fallback": {
      "dependsOn": ["@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "validate:public-corpus": {
      "dependsOn": ["@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "build-web-covers": {
      "inputs": [
        "$TURBO_ROOT$/books/**/book.yml",
        "$TURBO_ROOT$/books/**/book-cover.png",
        "$TURBO_ROOT$/books/**/BookCover.png",
        "$TURBO_ROOT$/upcoming/**/upcoming.yml",
        "$TURBO_ROOT$/upcoming/**/book.yml",
        "$TURBO_ROOT$/upcoming/**/book-cover.png",
        "$TURBO_ROOT$/schema/book.schema.json",
        "$TURBO_ROOT$/schema/upcoming.schema.json",
        "$TURBO_ROOT$/tools/list_book_covers.py",
        "$TURBO_ROOT$/tools/manifest_books.py",
        "$TURBO_ROOT$/tools/book_specs.py",
        "$TURBO_ROOT$/tools/path_safety.py",
        "$TURBO_ROOT$/tools/book_output_stem.py",
        "$TURBO_ROOT$/packages/corpus-tasks/scripts/generate-book-cover-assets.mjs",
        "$TURBO_ROOT$/packages/corpus-tasks/scripts/book-cover-variants.mjs",
        "$TURBO_ROOT$/packages/corpus-tasks/package.json",
        "$TURBO_ROOT$/package-lock.json",
        "$TURBO_ROOT$/Makefile"
      ],
      "outputs": ["$TURBO_ROOT$/build/site-assets/book-covers/**"]
    },
    "build-manifest": {
      "dependsOn": ["build-web-covers"],
      "inputs": [
        "$TURBO_ROOT$/books/**",
        "$TURBO_ROOT$/semantic/**",
        "$TURBO_ROOT$/schema/**",
        "$TURBO_ROOT$/upcoming/**",
        "$TURBO_ROOT$/build/site-assets/book-covers/**",
        "$TURBO_ROOT$/src/after_certainty/**",
        "$TURBO_ROOT$/Makefile",
        "$TURBO_ROOT$/pyproject.toml",
        "$TURBO_ROOT$/uv.lock"
      ],
      "outputs": ["$TURBO_ROOT$/build/semantic-manifest.json"],
      "env": ["GITHUB_REPOSITORY", "MANIFEST_REF", "MANIFEST_RELEASE_TAG"]
    },
    "install-for-site": {
      "dependsOn": ["build-manifest"],
      "inputs": [
        "$TURBO_ROOT$/build/semantic-manifest.json",
        "$TURBO_ROOT$/build/site-assets/book-covers/**",
        "$TURBO_ROOT$/books/**",
        "$TURBO_ROOT$/upcoming/**",
        "$TURBO_ROOT$/scripts/install_local_manifest_for_site.py",
        "$TURBO_ROOT$/packages/corpus-tasks/scripts/install-for-site.mjs"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/data/local-semantic-manifest.json",
        "$TURBO_ROOT$/apps/site/data/local-intended-manifest-release.json",
        "$TURBO_ROOT$/apps/site/data/local-chapter-audio-manifest.json",
        "$TURBO_ROOT$/apps/site/data/manuscripts/**",
        "$TURBO_ROOT$/apps/site/data/chapter-audio/**",
        "$TURBO_ROOT$/apps/site/public/generated/book-covers/**",
        "$TURBO_ROOT$/apps/site/public/generated/open-graph/**",
        "$TURBO_ROOT$/apps/site/public/generated/audio/**",
        "$TURBO_ROOT$/apps/site/public/manuscript-assets/**"
      ]
    },
    "parity": {
      "dependsOn": ["build-manifest"],
      "inputs": [
        "$TURBO_ROOT$/build/semantic-manifest.json",
        "$TURBO_ROOT$/tools/compare_manifest_parity.py"
      ],
      "outputs": [
        "$TURBO_ROOT$/reports/manifest-parity.json",
        "$TURBO_ROOT$/reports/manifest-parity.md"
      ]
    },
    "validate-manifest": {
      "dependsOn": ["build-manifest"],
      "inputs": ["$TURBO_ROOT$/build/semantic-manifest.json"],
      "outputs": []
    },
    "validate-web-covers": {
      "dependsOn": ["build-web-covers"],
      "inputs": [
        "$TURBO_ROOT$/build/site-assets/book-covers/**",
        "$TURBO_ROOT$/packages/corpus-tasks/scripts/validate-book-cover-assets.mjs"
      ],
      "outputs": []
    }
  }
}
