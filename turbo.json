{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "SEMANTIC_MANIFEST_USE_LOCAL",
        "SEMANTIC_MANIFEST_OFFLINE",
        "VERCEL_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "passThroughEnv": ["CACHE_REVALIDATE_SECRET", "PODCAST_RSS_URL"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "validate:fallback": {
      "dependsOn": ["@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "validate:public-corpus": {
      "dependsOn": ["@after-certainty/corpus-tasks#install-for-site"],
      "outputs": [],
      "env": ["SEMANTIC_MANIFEST_USE_LOCAL", "SEMANTIC_MANIFEST_OFFLINE"]
    },
    "build-manifest": {
      "inputs": [
        "$TURBO_ROOT$/books/**",
        "$TURBO_ROOT$/semantic/**",
        "$TURBO_ROOT$/schema/**",
        "$TURBO_ROOT$/upcoming/**",
        "$TURBO_ROOT$/tools/generate_semantic_manifest.py",
        "$TURBO_ROOT$/tools/discovery_manifest.py",
        "$TURBO_ROOT$/tools/manifest_books.py",
        "$TURBO_ROOT$/tools/manifest_markdown.py",
        "$TURBO_ROOT$/tools/book_specs.py",
        "$TURBO_ROOT$/tools/manuscript_structure.py",
        "$TURBO_ROOT$/tools/pattern_yaml.py",
        "$TURBO_ROOT$/tools/validate_book_specs.py",
        "$TURBO_ROOT$/tools/verify_semantic_yaml.py",
        "$TURBO_ROOT$/Makefile",
        "$TURBO_ROOT$/pyproject.toml",
        "$TURBO_ROOT$/uv.lock"
      ],
      "outputs": ["$TURBO_ROOT$/build/semantic-manifest.json"],
      "env": ["GITHUB_REPOSITORY", "MANIFEST_REF", "MANIFEST_RELEASE_TAG"]
    },
    "install-for-site": {
      "dependsOn": ["build-manifest"],
      "inputs": [
        "$TURBO_ROOT$/build/semantic-manifest.json",
        "$TURBO_ROOT$/scripts/install_local_manifest_for_site.py"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/data/local-semantic-manifest.json",
        "$TURBO_ROOT$/apps/site/data/local-intended-manifest-release.json"
      ]
    },
    "parity": {
      "dependsOn": ["build-manifest"],
      "inputs": [
        "$TURBO_ROOT$/build/semantic-manifest.json",
        "$TURBO_ROOT$/tools/compare_manifest_parity.py"
      ],
      "outputs": [
        "$TURBO_ROOT$/reports/manifest-parity.json",
        "$TURBO_ROOT$/reports/manifest-parity.md"
      ]
    },
    "validate-manifest": {
      "dependsOn": ["build-manifest"],
      "inputs": ["$TURBO_ROOT$/build/semantic-manifest.json"],
      "outputs": []
    }
  }
}
