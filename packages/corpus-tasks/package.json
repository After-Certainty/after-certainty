{
  "name": "@after-certainty/corpus-tasks",
  "private": true,
  "description": "Thin npm/Turbo wrappers around Make corpus tasks (Python stays authoritative).",
  "type": "module",
  "scripts": {
    "build-manifest": "make -C ../.. generate-semantic-manifest",
    "build-web-covers": "node ./scripts/generate-book-cover-assets.mjs",
    "validate-web-covers": "node ./scripts/validate-book-cover-assets.mjs",
    "validate-manifest": "make -C ../.. validate-semantic-manifest",
    "parity": "make -C ../.. compare-manifest-parity",
    "install-for-site": "make -C ../.. install-local-manifest-for-site",
    "test": "node --test ./scripts/generate-book-cover-assets.test.mjs ./scripts/validate-book-cover-assets.test.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
