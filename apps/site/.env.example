# Copy to `.env.local` and fill in secret values. `.env.local` is gitignored.

# Public site URL — canonical links, Open Graph, RSS, JSON-LD (`NEXT_PUBLIC_SITE_URL`).
# Production (example): https://www.after-certainty.com
# Local dev — optional; metadata falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Podcast — server-side RSS fetch for `/podcast` (ISR ~1h). Falls back to `data/podcast-episodes.json` if unset or unreachable.
PODCAST_RSS_URL=

# On-demand cache refresh — POST /api/cache/revalidate with `Authorization: Bearer <secret>`.
# Revalidates podcast RSS only. Set in production only.
# CACHE_REVALIDATE_SECRET=

# Semantic graph — Stage E local-only runtime loading.
# Generate + install first: npm run corpus:build-manifest && npm run site:install-local-manifest
# SEMANTIC_MANIFEST_OFFLINE=1
# SEMANTIC_MANIFEST_USE_LOCAL=1
# SEMANTIC_MANIFEST_FALLBACK_STALE_DAYS=30
# VALIDATE_FALLBACK_STRICT=1
# WRITE_MANIFEST_BUILD_LOCK=1

# Optional listening / directory links (shown on `/podcast`). Defaults exist for Spotify / RSS / GitHub when unset.
# NEXT_PUBLIC_PODCAST_SPOTIFY_URL=
# NEXT_PUBLIC_PODCAST_APPLE_URL=
# NEXT_PUBLIC_PODCAST_YOUTUBE_URL=
# NEXT_PUBLIC_GITHUB_DISCUSSIONS_URL=

# Site footer social icons (`resolveSiteSocialLinks`). Optional overrides:
# NEXT_PUBLIC_SOCIAL_GITHUB_URL=
# NEXT_PUBLIC_SOCIAL_SUBSTACK_URL=
# NEXT_PUBLIC_SOCIAL_MEDIUM_URL=
# NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
# NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=

# Google Analytics 4 — measurement ID (public). Defaults to G-H7FSEF4WLW when unset.
# Loaded only on Vercel production (or local `next start` without VERCEL_ENV).
# Preview deploys: set NEXT_PUBLIC_GA_ENABLE_PREVIEW=1 to opt in.
# Analytics cookies / storage require Accept on the cookie banner (Consent Mode denied by default globally).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-H7FSEF4WLW
# NEXT_PUBLIC_GA_ENABLE_PREVIEW=
#
# GA4 Admin checklist:
# - Data streams → enable Consent Mode on the web stream
# - Enhanced measurement: page views on; "Page changes based on browser history events" on (Next.js App Router SPA navigations)
# - Consent defaults: analytics_storage denied globally until Accept (see lib/consent/consent-defaults-script.ts)
# - DebugView: verify denied until Accept; after Accept, one page_view + history-based navigations
