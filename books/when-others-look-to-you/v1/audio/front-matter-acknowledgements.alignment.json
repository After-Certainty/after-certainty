{
  "schemaVersion": 1,
  "unitId": "chapter-when-others-look-to-you-v1-front-matter-acknowledgements",
  "generationHash": "sha256:15ac345d2cc0a14025c6b6c6fb74a4cbf795864de25f2ebedd68b2004109e21d",
  "granularity": "segment-only",
  "segments": [
    {
      "id": "s0001",
      "text": "Acknowledgements",
      "startMs": 0.0,
      "endMs": 975.0,
      "charStart": 0,
      "charEnd": 16
    },
    {
      "id": "s0002",
      "text": "This book did not come from a single moment.",
      "startMs": 1788.0,
      "endMs": 4864.0,
      "charStart": 18,
      "charEnd": 62
    },
    {
      "id": "s0003",
      "text": "It came from many small ones, repeated over time.",
      "startMs": 4864.0,
      "endMs": 8870.0,
      "charStart": 62,
      "charEnd": 111
    },
    {
      "id": "s0004",
      "text": "To my wife, Brittany",
      "startMs": 9264.0,
      "endMs": 10890.0,
      "charStart": 114,
      "charEnd": 134
    },
    {
      "id": "s0005",
      "text": "Thank you for your constant encouragement and belief.",
      "startMs": 11586.0,
      "endMs": 15011.0,
      "charStart": 136,
      "charEnd": 189
    },
    {
      "id": "s0006",
      "text": "You have not only supported this work, you have lived it.",
      "startMs": 15011.0,
      "endMs": 18715.0,
      "charStart": 189,
      "charEnd": 246
    },
    {
      "id": "s0007",
      "text": "You’ve taught me these patterns in ways I could not have learned on my own, and you’ve given me the space to try, fail, and try again.",
      "startMs": 18715.0,
      "endMs": 27051.0,
      "charStart": 246,
      "charEnd": 380
    },
    {
      "id": "s0008",
      "text": "To my children",
      "startMs": 28456.0,
      "endMs": 29327.0,
      "charStart": 384,
      "charEnd": 398
    },
    {
      "id": "s0009",
      "text": "You’ve helped me see what it means to feel the consequences of what I decide—not as an idea on paper, but in how it lands on the people closest to me.",
      "startMs": 30441.0,
      "endMs": 40112.0,
      "charStart": 400,
      "charEnd": 550
    },
    {
      "id": "s0010",
      "text": "You respond to what I do far more than what I say.",
      "startMs": 40809.0,
      "endMs": 44141.0,
      "charStart": 551,
      "charEnd": 601
    },
    {
      "id": "s0011",
      "text": "The examples add up in small moments until they outweigh anything I could announce.",
      "startMs": 44141.0,
      "endMs": 50573.0,
      "charStart": 601,
      "charEnd": 684
    },
    {
      "id": "s0012",
      "text": "To my parents",
      "startMs": 51606.0,
      "endMs": 52558.0,
      "charStart": 687,
      "charEnd": 700
    },
    {
      "id": "s0013",
      "text": "You’ve shown me, over time, that plans can yield when life won’t fit the old story.",
      "startMs": 53673.0,
      "endMs": 58909.0,
      "charStart": 702,
      "charEnd": 785
    },
    {
      "id": "s0014",
      "text": "There is honesty in that.",
      "startMs": 59118.0,
      "endMs": 60534.0,
      "charStart": 786,
      "charEnd": 811
    },
    {
      "id": "s0015",
      "text": "I learned more from what you practiced than from anything taught step by step.",
      "startMs": 60534.0,
      "endMs": 65155.0,
      "charStart": 811,
      "charEnd": 889
    },
    {
      "id": "s0016",
      "text": "What mattered to you kept showing up in me anyway.",
      "startMs": 65155.0,
      "endMs": 68348.0,
      "charStart": 889,
      "charEnd": 939
    },
    {
      "id": "s0017",
      "text": "Those lessons have stayed with me longer than anything that could have been said directly.",
      "startMs": 68348.0,
      "endMs": 73897.0,
      "charStart": 939,
      "charEnd": 1029
    },
    {
      "id": "s0018",
      "text": "To Alistair Cockburn",
      "startMs": 74977.0,
      "endMs": 76347.0,
      "charStart": 1034,
      "charEnd": 1054
    },
    {
      "id": "s0019",
      "text": "Thank you for teaching me how to see and speak in patterns.",
      "startMs": 77160.0,
      "endMs": 80875.0,
      "charStart": 1056,
      "charEnd": 1115
    },
    {
      "id": "s0020",
      "text": "Your influence is present throughout this book, not just in what is written, but in how it is shaped.",
      "startMs": 80875.0,
      "endMs": 87121.0,
      "charStart": 1115,
      "charEnd": 1216
    },
    {
      "id": "s0021",
      "text": "To Anderson Shen, Herb Collins, Jeremy Smith, Dee Grey, Daniel Bean, Tyler Chapman, and Justin Kenlon",
      "startMs": 87574.0,
      "endMs": 97570.0,
      "charStart": 1219,
      "charEnd": 1320
    },
    {
      "id": "s0022",
      "text": "Your examples make this real.",
      "startMs": 97953.0,
      "endMs": 100206.0,
      "charStart": 1322,
      "charEnd": 1351
    },
    {
      "id": "s0023",
      "text": "The ideas in this book are not abstract to me because I’ve seen them lived out through you.",
      "startMs": 100206.0,
      "endMs": 105279.0,
      "charStart": 1351,
      "charEnd": 1442
    },
    {
      "id": "s0024",
      "text": "And to the many small, easy-to-miss moments when people suddenly knew where to",
      "startMs": 105836.0,
      "endMs": 110701.0,
      "charStart": 1445,
      "charEnd": 1523
    },
    {
      "id": "s0025",
      "text": "look, something happened, and someone learned from it.",
      "startMs": 110771.0,
      "endMs": 114207.0,
      "charStart": 1524,
      "charEnd": 1578
    },
    {
      "id": "s0026",
      "text": "This book is an attempt to notice those moments more clearly.",
      "startMs": 114590.0,
      "endMs": 118282.0,
      "charStart": 1580,
      "charEnd": 1641
    }
  ]
}
